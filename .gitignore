# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment (NEVER commit local secrets)
.env
.env.local
.env.*.local
.env.production
!.env.example
!.env.production.example
!.env.local.example

# Logs
logs/
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json

# Testing
coverage/

# Prisma
apps/backend/prisma/migrations/**/migration_lock.toml

# ==============================================================================
# GitOps & DevOps Tracking Configuration
# ==============================================================================

# Allow tracking of Dockerfiles and Compose templates
docker-data/
docker/
docker-compose*.yml
.dockerignore
# **/Dockerfile (Commented out to track Next/Nest Dockerfiles)

# Exclude sensitive Terraform state, cache and local secrets
**/.terraform/
**/.terraform.lock.hcl
**/*.tfstate
**/*.tfstate.backup
**/terraform.tfvars

# Exclude all private/public key credentials
**/*.pem
**/*.key
credentials.json
