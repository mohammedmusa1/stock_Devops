# Copy to .env.production on your EC2 server (never commit real secrets)

# --- Database ---
POSTGRES_USER=namestock
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=namestock_ai

# --- Public URLs (use your domain after DNS points to EC2) ---
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_WS_URL=https://yourdomain.com

# --- API (apps/api) ---
JWT_ACCESS_SECRET=change_me_min_32_chars_random_string_here
JWT_REFRESH_SECRET=change_me_another_32_chars_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional email (Resend free tier)
RESEND_API_KEY=
EMAIL_FROM=Name Stock AI <onboarding@resend.dev>

# --- Resource tuning (optional) ---
# NODE_OPTIONS=--max-old-space-size=384
