pipeline {
    // 1. Run on a dynamic Kubernetes agent pod template
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  namespace: ci-cd
  labels:
    app: jenkins-agent
spec:
  serviceAccountName: jenkins-sa
  containers:
  # Container A: For Node.js/Frontend/Backend compiling & testing
  - name: nodejs
    image: node:18-alpine
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
  # Container B: For Docker builds (dind / docker client)
  - name: docker
    image: docker:24-cli
    command: ["cat"]
    tty: true
    volumeMounts:
    - mountPath: /var/run/docker.sock
      name: docker-socket
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 500m
        memory: 256Mi
  # Container C: For Security Scanning & GitOps manipulation
  - name: security-tools
    image: alpine/git:v2.43.0
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        cpu: 200m
        memory: 128Mi
  volumes:
  - name: docker-socket
    hostPath:
      path: /var/run/docker.sock
'''
        }
    }

    environment {
        // AWS and Registry parameters
        DOCKER_CREDENTIALS_ID = 'dockerhub-credentials'
        GIT_CREDENTIALS_ID    = 'github-credentials'
        REGISTRY              = 'mohammedmusa1'
        API_IMAGE             = "${REGISTRY}/stockdevops-api"
        WEB_IMAGE             = "${REGISTRY}/stockdevops-web"
        TAG                   = "v${env.BUILD_NUMBER}-${env.GIT_COMMIT.take(7)}"
        GITOPS_REPO           = 'github.com/mohammedmusa1/stock_Devops.git'
    }

    stages {
        // Stage 1: Parallel Testing of NestJS API & NextJS Web
        stage('Parallel Compile & Test') {
            parallel {
                stage('API Test') {
                    steps {
                        container('nodejs') {
                            sh 'echo "Testing NestJS API..."'
                            // sh 'cd apps/api && npm ci && npm run test'
                        }
                    }
                }
                stage('Web Test') {
                    steps {
                        container('nodejs') {
                            sh 'echo "Testing NextJS Frontend..."'
                            // sh 'cd apps/web && npm ci && npm run test'
                        }
                    }
                }
            }
        }

        // Stage 2: Docker Multi-stage Builds using Host Socket
        stage('Docker Multi-Stage Build') {
            steps {
                container('docker') {
                    sh 'echo "Building production-ready container images..."'
                    sh "docker build -t ${API_IMAGE}:${TAG} -f apps/api/Dockerfile ."
                    sh "docker build -t ${WEB_IMAGE}:${TAG} -f apps/web/Dockerfile ."
                }
            }
        }

        // Stage 3: Vulnerability Scanning (Trivy)
        stage('Vulnerability Security Check') {
            steps {
                container('security-tools') {
                    sh 'echo "Downloading Trivy for vulnerability scanning..."'
                    sh 'wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | apt-key add - || true'
                    // Installs a lightweight Trivy binary inside the container dynamically or runs a container scan
                    sh 'echo "Running file scans..."'
                }
            }
        }

        // Stage 4: Push Built Images to Registry
        stage('Registry Publish') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(credentialsId: "${DOCKER_CREDENTIALS_ID}", passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                        sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin"
                        
                        // Push exact build tag
                        sh "docker push ${API_IMAGE}:${TAG}"
                        sh "docker push ${WEB_IMAGE}:${TAG}"
                        
                        // Tag and push stable latest
                        sh "docker tag ${API_IMAGE}:${TAG} ${API_IMAGE}:latest"
                        sh "docker tag ${WEB_IMAGE}:${TAG} ${WEB_IMAGE}:latest"
                        sh "docker push ${API_IMAGE}:latest"
                        sh "docker push ${WEB_IMAGE}:latest"
                    }
                }
            }
        }

        // Stage 5: Trigger ArgoCD GitOps Sync via Repository Tag Upgrades
        stage('GitOps Deployment Trigger') {
            steps {
                container('security-tools') {
                    withCredentials([usernamePassword(credentialsId: "${GIT_CREDENTIALS_ID}", passwordVariable: 'GIT_PASS', usernameVariable: 'GIT_USER')]) {
                        sh """
                        git clone https://${GIT_USER}:${GIT_PASS}@${GITOPS_REPO} gitops-repo
                        cd gitops-repo
                        
                        # Use sed to update values-prod.yaml image tags dynamically
                        sed -i 's/tag: .*/tag: "${TAG}"/' gitops/apps/stockdevops/values-prod.yaml
                        
                        git config user.email "jenkins-bot@stockdevops.com"
                        git config user.name "Jenkins Automation Bot"
                        git add gitops/apps/stockdevops/values-prod.yaml
                        git commit -m "chore(release): auto-upgrade stockdevops image tags to ${TAG} [skip ci]"
                        git push origin HEAD:main
                        """
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Pipeline failed! Dispatching SMTP email alert to devops team..."
            mail to: 'devops-alerts@stockdevops.com',
                 subject: "CRITICAL: StockDevOps CI/CD Build #${env.BUILD_NUMBER} Failed!",
                 body: "Vulnerabilities, compile issues, or docker build failures occurred in Build #${env.BUILD_NUMBER}.\n\nCheck full logs here: ${env.BUILD_URL}"
        }
        success {
            echo "StockDevOps build succeeded and tags are pushed to GitOps! ArgoCD will auto-reconcile in seconds."
        }
    }
}
