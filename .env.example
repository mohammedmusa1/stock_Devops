# StockForge AI - Environment Template
# Copy to apps/api/.env and apps/web/.env.local

NODE_ENV=development

DATABASE_URL=postgresql://stockforge:stockforge_dev_password@localhost:5432/stockforge_ai?schema=public
REDIS_URL=redis://localhost:6379

API_PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_PROVIDER=resend
RESEND_API_KEY=
