{
  "name": "stockforge-ai",
  "version": "1.0.0",
  "private": true,
  "description": "StockForge AI - Production-grade stock trading & portfolio platform",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "predev": "node scripts/check-deps.mjs",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "deps:up": "docker compose up -d",
    "deps:check": "node scripts/check-deps.mjs",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "docker:diagnose": "powershell -ExecutionPolicy Bypass -File scripts/diagnose-docker.ps1",
    "validate:step": "node scripts/validate-step.mjs",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
